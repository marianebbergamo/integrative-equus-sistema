# Copie este arquivo para .env.local e preencha com os valores do projeto
# criado em https://supabase.com/dashboard (Project Settings > API).
# NÃO use o projeto pausado "Integrative-Equus-FB": crie um projeto novo.

# URL do projeto (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública/anônima (Project Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
